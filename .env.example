# Copy this file to .env and fill in the values. .env is ignored by git.

# Required. Your OpenAI API key.
OPENAI_API_KEY=

# Required to use the /admin endpoints and the Admin tab. Any long random string works:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional overrides. The values shown are the defaults.
# LLM_MODEL=gpt-5.6-luna
# REASONING_EFFORT=none
# EMBEDDING_MODEL=text-embedding-3-small
# RETRIEVAL_TOP_K=6
# THREAD_RETENTION_DAYS=30
# RATE_LIMIT_PER_MINUTE=20
# DAILY_QUESTION_LIMIT=300
# SUBSTACK_PUBLICATION=explainthedata
# CORS_ORIGINS=["http://localhost:8501"]
# DATA_DIR=./data

# Public deployment only (docker-compose.prod.yml): the address Caddy serves, e.g. a domain name
# or 203-0-113-7.sslip.io. See docs/DEPLOY.md.
# SITE_ADDRESS=
